#!/bin/sh

# Script para sincronizar dotfiles con GitHub
# Uso: dotfiles-sync [mensaje_del_commit]

DOTFILES_DIR="$HOME/.dotfiles"
ALIAS='git --git-dir='"$DOTFILES_DIR"' --work-tree='"$HOME"

# Colores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${YELLOW}=== Syncing dotfiles ===${NC}"

# Verificar que el repo bare existe
if [ ! -d "$DOTFILES_DIR" ]; then
    echo "${RED}Error: $DOTFILES_DIR no existe${NC}"
    echo "Inicializa primero con: git init --bare $DOTFILES_DIR"
    exit 1
fi

# Verificar que hay un remote configurado
REMOTE_URL=$($ALIAS remote get-url origin 2>/dev/null)
if [ -z "$REMOTE_URL" ]; then
    echo "${RED}Error: No hay remote configurado${NC}"
    echo "Añade uno con: dotfiles remote add origin git@github.com:Myrielt/dotfiles.git"
    exit 1
fi

echo "Remote: $REMOTE_URL"

# Añadir archivos de config que queremos trackear
echo "${YELLOW}Añadiendo configs...${NC}"

$ALIAS add ~/.config/nvim 2>/dev/null
$ALIAS add ~/.config/lazygit 2>/dev/null
$ALIAS add ~/.gitconfig 2>/dev/null
$ALIAS add ~/.ssh/config 2>/dev/null
$ALIAS add ~/.profile 2>/dev/null
$ALIAS add ~/.bashrc 2>/dev/null

# Verificar si hay cambios
STATUS=$($ALIAS status --short)

if [ -z "$STATUS" ]; then
    echo "${GREEN}No hay cambios para sincronizar${NC}"
    exit 0
fi

echo "${YELLOW}Cambios detectados:${NC}"
echo "$STATUS"

# Mensaje del commit
if [ -n "$1" ]; then
    MSG="$1"
else
    # Auto-generar mensaje con fecha
    MSG="Update dotfiles - $(date '+%Y-%m-%d %H:%M')"
fi

echo "${YELLOW}Commit: $MSG${NC}"
$ALIAS commit -m "$MSG"

# Push
echo "${YELLOW}Pushing a origin main...${NC}"
$ALIAS push origin main

if [ $? -eq 0 ]; then
    echo "${GREEN}✓ Dotfiles sincronizados correctamente${NC}"
else
    echo "${RED}✗ Error al hacer push${NC}"
    exit 1
fi
