#!/bin/sh

# Script para restaurar dotfiles en un nuevo entorno Proot/Alpine
# Uso: dotfiles-restore

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

DOTFILES_REPO="git@github.com:Myrielt/dotfiles.git"
DOTFILES_DIR="$HOME/.dotfiles"
ALIAS='git --git-dir='"$DOTFILES_DIR"' --work-tree='"$HOME"

echo "${BLUE}=== Restaurando dotfiles ===${NC}"

# 1. Verificar dependencias esenciales
echo "${YELLOW}[1/7] Verificando dependencias...${NC}"

for pkg in git curl build-base cmake ninja gettext-tiny-dev unzip tar gzip; do
    if ! apk info -e "$pkg" >/dev/null 2>&1; then
        echo "  Instalando $pkg..."
        apk add "$pkg" >/dev/null 2>&1 || true
    fi
done

# 2. Clonar dotfiles bare
echo "${YELLOW}[2/7] Clonando dotfiles...${NC}"

if [ -d "$DOTFILES_DIR" ]; then
    echo "  $DOTFILES_DIR ya existe, respaldando..."
    mv "$DOTFILES_DIR" "$DOTFILES_DIR.bak.$(date +%s)"
fi

git clone --bare "$DOTFILES_REPO" "$DOTFILES_DIR"

# 3. Crear alias y configurar
echo "${YELLOW}[3/7] Configurando dotfiles...${NC}"

mkdir -p ~/bin
cat > ~/bin/dotfiles << 'EOF'
#!/bin/sh
/usr/bin/git --git-dir=$HOME/.dotfiles --work-tree=$HOME "$@"
EOF
chmod +x ~/bin/dotfiles

echo 'export PATH="$HOME/bin:$PATH"' >> ~/.profile
echo 'alias dotfiles="/usr/bin/git --git-dir=$HOME/.dotfiles --work-tree=$HOME"' >> ~/.profile

export PATH="$HOME/bin:$PATH"

$ALIAS config --local status.showUntrackedFiles no

# 4. Checkout de los archivos
echo "${YELLOW}[4/7] Restaurando archivos de configuración...${NC}"

# Si hay conflictos, respaldar
$ALIAS checkout 2>/dev/null || {
    echo "  Resolviendo conflictos..."
    mkdir -p ~/.dotfiles-backup
    $ALIAS checkout 2>&1 | grep -E "^\s+" | awk '{print $1}' | while read -r f; do
        [ -f "$f" ] && mkdir -p "$(dirname "$HOME/.dotfiles-backup/$f")" && cp "$f" "$HOME/.dotfiles-backup/$f"
    done
    $ALIAS checkout -f
}

# 5. Instalar Neovim si no existe o es viejo
echo "${YELLOW}[5/7] Verificando Neovim...${NC}"

NVIM_VER=$(nvim --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || echo "0.0.0")

if [ "$(printf '%s\n' "0.12.0" "$NVIM_VER" | sort -V | head -n1)" != "0.12.0" ]; then
    echo "  Compilando Neovim 0.12 desde fuente..."
    
    apk add coreutils linux-headers libuv-dev msgpack-c-dev luajit-dev liblpeg-dev 2>/dev/null || true
    
    cd ~
    [ -d neovim ] && rm -rf neovim
    git clone --depth 1 --branch stable https://github.com/neovim/neovim.git
    cd neovim
    make CMAKE_BUILD_TYPE=Release
    make install
    cd ~
    rm -rf neovim
    
    echo "${GREEN}  Neovim instalado: $(nvim --version | head -1)${NC}"
else
    echo "  Neovim $NVIM_VER ya está actualizado"
fi

# 6. Instalar lazygit
echo "${YELLOW}[6/7] Verificando lazygit...${NC}"

if ! command -v lazygit >/dev/null 2>&1; then
    echo "  Instalando lazygit..."
    apk add lazygit 2>/dev/null || {
        # Fallback: compilar desde fuente
        cd ~
        git clone --depth 1 https://github.com/jesseduffield/lazygit.git
        cd lazygit
        go install 2>/dev/null || echo "${RED}  Go no disponible, lazygit no instalado${NC}"
        cd ~
        rm -rf lazygit
    }
fi

# 7. Instalar plugins de LazyVim
echo "${YELLOW}[7/7] Instalando plugins de LazyVim...${NC}"

rm -rf ~/.local/share/nvim ~/.local/state/nvim ~/.cache/nvim

# Primera ejecución silenciosa para instalar todo
nvim --headless "+Lazy! sync" +qa 2>/dev/null || {
    echo "  Abre nvim manualmente para completar la instalación de plugins"
}

# 8. Verificar SSH
echo "${YELLOW}Verificando SSH...${NC}"

if [ -f ~/.ssh/gitkey ]; then
    chmod 600 ~/.ssh/gitkey
    chmod 644 ~/.ssh/gitkey.pub 2>/dev/null || true
    chmod 644 ~/.ssh/config 2>/dev/null || true
    
    ssh -T git@github.com 2>&1 | grep -q "successfully authenticated" && \
        echo "${GREEN}  SSH OK${NC}" || \
        echo "${YELLOW}  Verifica que la llave SSH esté añadida en GitHub${NC}"
else
    echo "${YELLOW}  No se encontró ~/.ssh/gitkey - genera una nueva con: ssh-keygen -t ed25519${NC}"
fi

echo ""
echo "${GREEN}=== Restauración completada ===${NC}"
echo ""
echo "Próximos pasos:"
echo "  1. Recarga la shell: source ~/.profile"
echo "  2. Abre nvim para verificar que todo cargó bien"
echo "  3. Si falta la llave SSH, genera una nueva y añádela en GitHub"
echo ""
echo "Para sincronizar cambios futuros:"
echo "  dotfiles-sync"
